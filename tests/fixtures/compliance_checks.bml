// Test fixture for compliance checking (Phase 4)
// Contains elements with Check and CheckSuite declarations

# Site: ComplianceTestSite
  location: 48.1351, 11.5820

## Building: Office Block A
  type: commercial

### Storey: Ground Floor
  elevation: 0.0 m
  height: 3.50 m

#### Space: Main Corridor
  usage: corridor
  area: 25.0 m2

  Wall: W-EXT-01
    from: (0, 0) to: (10, 0)
    height: 3.50 m
    thickness: 0.365 m
    material: exterior_wall
    is_external: true
    load_bearing: true
    fire_rating: REI90

    Door: D-MAIN
      offset: 3.0 m
      width: 1.20 m
      height: 2.10 m
      type: double_leaf
      is_external: true
      fire_rating: T30

    Door: D-NARROW
      offset: 7.0 m
      width: 0.75 m
      height: 2.10 m
      type: single_leaf

  Wall: W-INT-01
    from: (0, 0) to: (0, 5)
    height: 3.50 m
    thickness: 0.115 m
    is_external: false
    load_bearing: false

#### Space: Office A
  usage: office
  area: 20.0 m2

  Wall: W-EXT-02
    from: (0, 5) to: (10, 5)
    height: 3.50 m
    thickness: 0.365 m
    material: exterior_wall
    is_external: true
    load_bearing: true
    fire_rating: REI60

    Window: WIN-01
      offset: 1.0 m
      width: 2.0 m
      height: 1.6 m
      sill_height: 0.80 m
      type: triple_glazed
      u_value: 0.7 W/m2K

    Window: WIN-02
      offset: 5.0 m
      width: 1.5 m
      height: 1.4 m
      sill_height: 0.90 m
      type: double_glazed

  Slab: SLAB-GF
    boundary: [(0,0), (10,0), (10,5), (0,5)]
    thickness: 0.25 m
    material: reinforced_concrete
    slab_type: floor

  Beam: B-01
    from: (0, 2.5) to: (10, 2.5)
    profile: rectangle(0.3, 0.5)
    material: reinforced_concrete

// Standalone check: door width compliance
Check: min_door_width
  description: "All doors must be at least 0.90 m wide"
  applies_to: Door
  assert: width >= 0.90

// Check suite for fire safety
CheckSuite: fire_safety
  description: "Fire safety compliance checks"
  jurisdiction: DE
  version: "2024"
  section: "Section 5.1"

  Check: ext_wall_fire_rating
    description: "External walls must have fire rating"
    applies_to: Wall
    where: is_external == true
    assert: fire_rating in [REI30, REI60, REI90, REI120]

  Check: fire_door_rating
    description: "External doors need fire rating"
    applies_to: Door
    where: is_external == true
    assert: fire_rating in [T30, T60, T90]
