    boundary: [(0,0), (10,0), (10,8), (0,8)]
    thickness: 0.22 m
    material: reinforced_concrete
    slab_type: floor

  // Load-bearing beam at mid-span
  Beam: B-FF-01
    from: (0, 4.5) to: (10, 4.5)
    profile: rectangle(0.30, 0.40)
    material: reinforced_concrete

  Column: COL-FF-01
    position: (5.0, 4.5)
    height: 2.60 m
    profile: rectangle(0.30, 0.30)
    material: reinforced_concrete

