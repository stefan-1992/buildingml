// Level 4 - Library pavilion and roof terrace
// elevation 15.7 m, height 3.6 m
// A twisted, fully glazed library pavilion sits on the office block. The rest
// of the slab is a roof terrace with glass railings and planters. The east stair
// core continues as a closed box on the terrace.

import materials from "../materials.bml"
import assets from "../assets/furniture.bml"

