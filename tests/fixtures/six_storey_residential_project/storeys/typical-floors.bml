// Floors 1-4 ?Residential (10 units per floor via template)
// Each floor uses TypicalResidentialFloor template with variable substitution
// Plus per-floor stairs connecting to the next storey
//
// Template must be in same file as apply_template directives
// (template expansion operates on a single SourceFile)
// Materials are loaded via project.bml import and merged at semantic analysis time.

// =========================================================================
// Template: TypicalResidentialFloor
// Reused for Floors 1-4 (10 units per floor, identical layout)
// Variables: {f} = floor prefix (F1..F4), {n} = unit number prefix (1..4)
// =========================================================================

Template: TypicalResidentialFloor

  // Storey-level structural elements
  Slab: SLAB-{f}
    boundary: [(0.15,0.15), (39.85,0.15), (39.85,17.85), (0.15,17.85)]
    thickness: 0.25 m
    material: reinforced_concrete
    slab_type: floor

  // South facade columns
  Column: COL-{f}-01
    position: (8.0, 0.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-02
    position: (16.0, 0.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-03
    position: (24.0, 0.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-04
    position: (32.0, 0.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  // Corridor columns
  Column: COL-{f}-05
    position: (8.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-06
    position: (16.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-07
    position: (24.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-08
    position: (32.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  // North facade columns
  Column: COL-{f}-09
    position: (8.0, 18.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-10
    position: (16.0, 18.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-11
    position: (24.0, 18.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-12
    position: (32.0, 18.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  // Transverse beams
  Beam: B-{f}-01
    from: (8, 0) to: (8, 18)
    profile: rectangle(0.35, 0.55)
    material: reinforced_concrete

  Beam: B-{f}-02
    from: (16, 0) to: (16, 18)
    profile: rectangle(0.35, 0.55)
    material: reinforced_concrete

  Beam: B-{f}-03
    from: (24, 0) to: (24, 18)
    profile: rectangle(0.35, 0.55)
    material: reinforced_concrete

  Beam: B-{f}-04
    from: (32, 0) to: (32, 18)
    profile: rectangle(0.35, 0.55)
    material: reinforced_concrete

// --- Template spaces ---

#### Space: Central Corridor {f}
  usage: corridor
  area: 72.0 m2
  zone: corridor
  boundary: [(3, 8), (37, 8), (37, 10), (3, 10)]

