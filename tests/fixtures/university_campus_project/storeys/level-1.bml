// Level 1 - Lecture and seminar rooms
// elevation 4.5 m, height 4.0 m
// Three lecture rooms on the south side behind timber sun fins, a 4 m wide
// learning street, seminar rooms to the north and a gallery around the atrium.
// The roof of the mensa bulge below is a green roof.

import materials from "../materials.bml"
import assets from "../assets/furniture.bml"

