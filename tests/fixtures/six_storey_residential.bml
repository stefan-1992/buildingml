// =========================================================================
// Roof Level ?Flat Roof + Rooftop Terrace
// elevation: 18.50 m
// Demonstrates: railing from: axis positioning
// =========================================================================

### Storey: Roof
  elevation: 18.50 m

  Roof: RF-01
    type: hip
    boundary: [(-0.3, -0.3), (40.3, -0.3), (40.3, 18.3), (-0.3, 18.3)]
    ridge_height: 3.5 m
    ridge_direction: x
    overhang: 0.5 m

  // Rooftop terrace slab (~1/3 of roof, south side, overhangs exterior walls)
  Slab: SLAB-TERRACE
    boundary: [(-0.3,-0.3), (40.3,-0.3), (40.3,6), (-0.3,6)]
    thickness: 0.15 m
    material: reinforced_concrete
    slab_type: roof

  // Terrace railings at slab edge
  Railing: RL-TERRACE-S
    from: (-0.3, -0.3) to: (40.3, -0.3)
    height: 1.10 m

  Railing: RL-TERRACE-E
    from: (40.3, -0.3) to: (40.3, 6)
    height: 1.10 m

  Railing: RL-TERRACE-W
    from: (-0.3, 6) to: (-0.3, -0.3)
    height: 1.10 m

  Railing: RL-TERRACE-N
    from: (-0.3, 6) to: (40.3, 6)
    height: 1.10 m

// =========================================================================
// Compliance Checks
// =========================================================================

// Accessibility: doors must be minimum 0.90 m
Check: min_door_width
  description: "All doors must be at least 0.90 m wide for accessibility"
  applies_to: Door
  assert: width >= 0.90

// Fire safety suite
CheckSuite: fire_safety
  description: "Fire safety compliance for residential buildings"
  jurisdiction: DE
  version: "2024"
  section: "Section 4.2"

  Check: ext_wall_fire_rating
    description: "External load-bearing walls require REI90 fire rating"
    applies_to: Wall
    where: is_external == true
    assert: fire_rating in [REI30, REI60, REI90, REI120]

  Check: fire_door_rating
    description: "External doors and stairwell doors need fire rating"
    applies_to: Door
    where: is_external == true
    assert: fire_rating in [T30, T60, T90]

  Check: stairwell_width
    description: "Stairwells must be at least 1.20 m wide"
    applies_to: Stair
    assert: width >= 1.20
