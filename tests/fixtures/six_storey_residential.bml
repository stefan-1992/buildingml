// Six-storey reinforced concrete residential building
// 48 dwelling units across 5 upper floors + ground-level common areas and parking
// Footprint: 40m x 18m, oriented east-west
//
// Layout key:
//   x-axis: 0 (west) to 40 (east)
//   y-axis: 0 (south, main entrance) to 18 (north, parking ramp)
//   Central corridor: y=8 to y=10 on residential floors
//   West stair core: x=0 to x=3
//   East stair core: x=37 to x=40
//   Elevator core: x=19 to x=21
//
// v0.2 features demonstrated:
//   - Template + apply_template (TypicalResidentialFloor for Floors 1-4)
//   - {variable} substitution in element IDs and space names
//   - Auto-ID generation (bare Type: without ID)
//   - Elevator element (IfcTransportElement)
//   - zone: property for space grouping
//   - Extended usage enum (lobby, parking, plant_room, etc.)
//   - Railing from: axis positioning
//   - Storey-level elements (slab, columns, beams before spaces)


// =========================================================================
// Material Definitions
// =========================================================================

Material: reinforced_concrete
  category: concrete
  grade: C30
  density: 2400 kg/m3

Material: exterior_insulated
  category: concrete
  density: 1800 kg/m3

Material: interior_partition
  category: concrete
  density: 1200 kg/m3

Material: shear_wall_concrete
  category: concrete
  grade: C30
  density: 2400 kg/m3

// =========================================================================
// Template: TypicalResidentialFloor
// Reused for Floors 1-4 (10 units per floor, identical layout)
// Variables: {f} = floor prefix (F1..F4), {n} = unit number prefix (1..4)
// =========================================================================

Template: TypicalResidentialFloor

  // Storey-level structural elements
  Slab: SLAB-{f}
    boundary: [(0.15,0.15), (39.85,0.15), (39.85,17.85), (0.15,17.85)]
    thickness: 0.25 m
    material: reinforced_concrete
    slab_type: floor

  // South facade columns
  Column: COL-{f}-01
    position: (8.0, 0.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-02
    position: (16.0, 0.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-03
    position: (24.0, 0.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-04
    position: (32.0, 0.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  // Corridor columns
  Column: COL-{f}-05
    position: (8.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-06
    position: (16.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-07
    position: (24.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-08
    position: (32.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  // North facade columns
  Column: COL-{f}-09
    position: (8.0, 18.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-10
    position: (16.0, 18.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-11
    position: (24.0, 18.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-{f}-12
    position: (32.0, 18.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  // Transverse beams
  Beam: B-{f}-01
    from: (8, 0) to: (8, 18)
    profile: rectangle(0.35, 0.55)
    material: reinforced_concrete

  Beam: B-{f}-02
    from: (16, 0) to: (16, 18)
    profile: rectangle(0.35, 0.55)
    material: reinforced_concrete

  Beam: B-{f}-03
    from: (24, 0) to: (24, 18)
    profile: rectangle(0.35, 0.55)
    material: reinforced_concrete

  Beam: B-{f}-04
    from: (32, 0) to: (32, 18)
    profile: rectangle(0.35, 0.55)
    material: reinforced_concrete

// --- Template spaces ---

