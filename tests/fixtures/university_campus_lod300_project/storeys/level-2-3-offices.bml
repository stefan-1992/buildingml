// Levels 2-3 - Offices (template OfficeFloor, applied twice)
// elevation 8.5 m / 12.1 m, height 3.6 m
// The office floors cantilever 4 m west over the entrance plaza and sit above
// the Audimax roof. Anthracite metal facade with ribbon windows and aluminium
// sun fins to the south; full-height glazing on the west end and slanted east facade.
// Variable: {f} = level code (L2, L3).
//
// Template must be in the same file as its apply_template directives.

import materials from "../materials.bml"
import assets from "../assets/furniture.bml"

Template: OfficeFloor

