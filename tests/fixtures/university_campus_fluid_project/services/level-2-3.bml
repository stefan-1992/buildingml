// Levels 2-3 - building services of the office floors (template ServicesOfficeFloor)
//
// Risers in the west shaft (x 3.925..5.0, y 20.925..23.825, beside the lift):
//   supply and extract air ducts, sprinkler, heating flow/return, rain water.
// Each floor leaves the shaft through fire dampers into the west lobby:
//   supply air  - south offices (y 3), open workspace (y 7), north offices and
//                 open strip (y 16.3), meeting and panorama rooms
//   extract air - north offices (y 19.55)
//   sprinkler   - one line per zone, one head per office
// Power and lighting tray from the riser beside the east lift (x 41.15).
// Duct centres at 2.98 m, pipes at 3.13 m, trays at 2.87 m above the floor;
// suspended ceilings at 2.76 m, slab soffit at 3.19 m.
// Variable: {f} = level code (L2, L3).

import materials from "../materials.bml"
import systems from "./systems.bml"

Template: ServicesOfficeFloor

  // ------------------------------------------------------------------
  // Risers (west shaft, east riser gap)
  // ------------------------------------------------------------------

  Duct: SA-{f}-R
    system: SA
    width: 0.25 m
    height: 1 m
    path: [(4.375, 21.5, 0), (4.375, 21.5, 3.6)]
    sleeve: true
    material: galvanised_steel_duct

  Duct: EA-{f}-R
    system: EA
    width: 0.25 m
    height: 1 m
    path: [(4.775, 21.5, 0), (4.775, 21.5, 3.6)]
    sleeve: true
    material: galvanised_steel_duct

  Pipe: SPR-{f}-R
    system: SPR
    diameter: 0.1 m
    path: [(4.15, 22.35, 0), (4.15, 22.35, 3.6)]
    sleeve: true
    material: sprinkler_steel

  Pipe: HTGF-{f}-R
    system: HTG
    diameter: 0.05 m
    from: (4.4, 22.35, 0) to: (4.4, 22.35, 3.6)
    sleeve: true
    material: heating_steel

  Pipe: HTGR-{f}-R
    system: HTG
    diameter: 0.05 m
    from: (4.6, 22.35, 0) to: (4.6, 22.35, 3.6)
