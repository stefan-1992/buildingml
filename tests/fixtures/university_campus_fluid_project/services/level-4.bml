// Level 4 - building services of the library floor
//
// The west shaft risers continue to the air handling unit on the roof; the
// sprinkler riser ends here. Reading room without suspended ceiling: supply
// ducts at 3.3 m, extract ducts at 3.36 m, pipes at 3.52 m below the roof
// slab soffit (3.6 m); diffusers, sprinkler heads and pendant lights below
// them. Group study rooms with
// ceilings at 3.17 m: terminals drop through the ceiling.
// Reading room air leaves through the atrium and its lantern.

import materials from "../materials.bml"
import systems from "./systems.bml"

# Site: Campus Nord

## Building: Forum Nord

### Storey: Level 4
  elevation: 15.7 m
  height: 3.6 m

  // ------------------------------------------------------------------
  // Risers (west shaft, east riser gap)
  // ------------------------------------------------------------------

  Duct: SA-L4-R
    system: SA
    width: 0.25 m
    height: 1 m
    path: [(4.375, 21.5, 0), (4.375, 21.5, 3.6)]
    sleeve: true
    material: galvanised_steel_duct

  Duct: EA-L4-R
    system: EA
    width: 0.25 m
    height: 1 m
    path: [(4.775, 21.5, 0), (4.775, 21.5, 3.6)]
