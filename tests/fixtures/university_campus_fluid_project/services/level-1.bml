// Level 1 - building services of the teaching floor
//
// All risers of the west shaft and the east power riser pass through. Lecture
// and seminar rooms have suspended ceilings at 3.16 m below the slab soffit
// (3.59 m): supply ducts at 3.34 m, extract ducts at 3.36 m, pipes at 3.52 m.
// Lecture rooms are supplied only; their air flows over into the learning
// street and the atrium. Seminar rooms have supply and extract. The atrium
// gallery has no ceiling: diffusers, heads and lights hang below the ducts.

import materials from "../materials.bml"
import systems from "./systems.bml"

# Site: Campus Nord

## Building: Forum Nord

### Storey: Level 1
  elevation: 4.5 m
  height: 4 m

  // ------------------------------------------------------------------
  // Risers (west shaft, east riser gap)
  // ------------------------------------------------------------------

  Duct: SA-L1-R
    system: SA
    width: 0.25 m
    height: 1 m
    path: [(4.375, 21.5, 0), (4.375, 21.5, 4)]
    sleeve: true
    material: galvanised_steel_duct

  Duct: EA-L1-R
    system: EA
    width: 0.25 m
    height: 1 m
    path: [(4.775, 21.5, 0), (4.775, 21.5, 4)]
    sleeve: true
    material: galvanised_steel_duct

  Pipe: SPR-L1-R
    system: SPR
    diameter: 0.1 m
    path: [(4.15, 22.35, 0), (4.15, 22.35, 3.52), (4.15, 22.35, 4)]
    sleeve: true
    material: sprinkler_steel

  Pipe: HTGF-L1-R
    system: HTG
    diameter: 0.05 m
    from: (4.4, 22.35, 0) to: (4.4, 22.35, 4)
    sleeve: true
