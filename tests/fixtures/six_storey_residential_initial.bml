  Column: COL-F5-01
    position: (8.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-F5-02
    position: (16.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-F5-03
    position: (24.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Column: COL-F5-04
    position: (32.0, 9.0)
    height: 3.00 m
    profile: rectangle(0.35, 0.35)
    material: reinforced_concrete

  Beam: B-F5-01
    from: (0, 9) to: (40, 9)
    profile: rectangle(0.35, 0.55)
    material: reinforced_concrete

// =========================================================================
// Roof Level ?Flat Roof + Rooftop Terrace
// elevation: 18.50 m
// =========================================================================

### Storey: Roof
  elevation: 18.50 m

  Roof: RF-01
    type: flat
    boundary: [(-0.3, -0.3), (40.3, -0.3), (40.3, 18.3), (-0.3, 18.3)]
    ridge_height: 0.3 m

  // Rooftop terrace slab (~1/3 of roof, south side)
  Slab: SLAB-TERRACE
    boundary: [(0,0), (40,0), (40,6), (0,6)]
    thickness: 0.15 m
    material: reinforced_concrete
    slab_type: roof

  // Terrace railing ?south
  Railing: RL-TERRACE-S
    height: 1.10 m
    length: 40.0 m

  // Terrace railing ?east
  Railing: RL-TERRACE-E
    height: 1.10 m
    length: 6.0 m

  // Terrace railing ?west
  Railing: RL-TERRACE-W
    height: 1.10 m
    length: 6.0 m

// =========================================================================
// Compliance Checks
// =========================================================================

// Accessibility: doors must be minimum 0.90 m
Check: min_door_width
  description: "All doors must be at least 0.90 m wide for accessibility"
  applies_to: Door
  assert: width >= 0.90

// Fire safety suite
CheckSuite: fire_safety
  description: "Fire safety compliance for residential buildings"
  jurisdiction: DE
  version: "2024"
  section: "Section 4.2"

  Check: ext_wall_fire_rating
    description: "External load-bearing walls require REI90 fire rating"
    applies_to: Wall
    where: is_external == true
    assert: fire_rating in [REI30, REI60, REI90, REI120]

  Check: fire_door_rating
    description: "External doors and stairwell doors need fire rating"
    applies_to: Door
    where: is_external == true
    assert: fire_rating in [T30, T60, T90]

  Check: stairwell_width
    description: "Stairwells must be at least 1.20 m wide"
    applies_to: Stair
    assert: width >= 1.20
