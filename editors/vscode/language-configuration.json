{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "folding": {
    "markers": {
      "start": "^#{1,4}\\s",
      "end": "^(?=#{1,4}\\s)"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(#{1,4}\\s+\\w+:|\\w+:\\s+\\w+[-\\w]*)\\s*$",
    "decreaseIndentPattern": "^\\s*$"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_-]*"
}
